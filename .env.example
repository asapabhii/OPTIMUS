# =============================================================================
# OPTIMUS TRUSTLAYER — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# --- Primary Store: Neon (managed Postgres 16) ---
# Fallback: AWS Aurora (dump/restore — vanilla Postgres throughout)
DATABASE_URL=postgresql+asyncpg://user:password@host/optimus?sslmode=require
DATABASE_URL_SYNC=postgresql://user:password@host/optimus?sslmode=require

# --- Per-user OAuth + Live Proxy: Nango Cloud ---
# Fallback: Nango hybrid (their runtime, our credential store) → Arcade enterprise
NANGO_SECRET_KEY=your-nango-secret-key
NANGO_PUBLIC_KEY=your-nango-public-key
NANGO_BASE_URL=https://api.nango.dev

# --- LLM Gateway: Portkey ---
# Fallback: LiteLLM Enterprise (config swap — OpenAI-compatible throughout)
PORTKEY_API_KEY=your-portkey-api-key
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# --- LLM Provider (routed through Portkey) ---
OPENAI_API_KEY=your-openai-api-key

# --- Entity Resolution: Splink + RapidFuzz (MIT — zero cost) ---
# No API key or license required. Runs entirely in-process.
# Thresholds tuned via Gate-1 stop-test against labeled corpus.
ER_AUTO_MERGE_THRESHOLD=0.85
ER_CONFLICT_THRESHOLD=0.50

# --- Observability: OTel → Grafana Cloud ---
# Fallback: Datadog
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
GRAFANA_OTLP_TOKEN=your-grafana-cloud-token
OTEL_SERVICE_NAME=optimus-trustlayer

# --- Batch Ingestion: Airbyte Cloud ---
# Fallback: Fivetran (inside Plane A only, for structured-CRM gaps)
AIRBYTE_API_KEY=your-airbyte-api-key
AIRBYTE_WORKSPACE_ID=your-airbyte-workspace-id

# --- Document Parsing: LlamaCloud ---
# Fallback: Unstructured Platform
LLAMA_CLOUD_API_KEY=your-llama-cloud-api-key

# --- Vector + Full-text: Qdrant Cloud ---
# Fallback: Turbopuffer (namespace-per-viewer) on measured need
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# --- Event Bus: Redpanda Cloud Serverless ---
# Fallback: Confluent Cloud (same Kafka protocol)
REDPANDA_BROKERS=your-broker:9092
REDPANDA_SASL_USERNAME=your-sasl-username
REDPANDA_SASL_PASSWORD=your-sasl-password
REDPANDA_SECURITY_PROTOCOL=SASL_SSL
REDPANDA_SASL_MECHANISM=SCRAM-SHA-256

# --- Workflow: Temporal Cloud ---
# Fallback: Self-hosted Temporal (same SDK, same code)
TEMPORAL_NAMESPACE=your-namespace
TEMPORAL_API_KEY=your-temporal-api-key
TEMPORAL_ENDPOINT=your-namespace.tmprl.cloud:7233

# --- Google OAuth (for Drive, Sheets, Gmail connectors via Nango) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- HubSpot (Private App — create at HubSpot > Legacy Apps) ---
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- Onboarding: fast-path ingestion ---
FAST_PATH_DEFAULT_N=50
BACKFILL_MAX_DEPTH_DAYS=365
