# Invalidation worker — webhook-driven staleness marking
FROM python:3.11-slim AS base

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml ./

RUN uv venv /app/.venv && \
    VIRTUAL_ENV=/app/.venv uv pip install -e "." --no-cache

ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

COPY libs/ libs/
COPY core/ core/
COPY engine/ engine/
COPY services/invalidation/ services/invalidation/

CMD ["python", "-m", "services.invalidation.main"]
